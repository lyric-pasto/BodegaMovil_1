<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".registro_ventas">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarVentas"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/orange_stronge"
            app:title="Registro de Venta"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/icon_back"
            app:navigationIconTint="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- CARD CLIENTE Y FECHA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tipo de Comprobante / Cliente"
                        android:textColor="@color/orange_stronge"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <!-- SELECTOR TIPO DE CLIENTE: NORMAL vs RUC -->
                    <RadioGroup
                        android:id="@+id/rgTipoCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:checkedButton="@id/rbClienteNormal"
                        android:layout_marginBottom="12dp">

                        <RadioButton
                            android:id="@+id/rbClienteNormal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Normal / DNI"
                            android:textSize="13sp"
                            android:textColor="#333333" />

                        <RadioButton
                            android:id="@+id/rbClienteRuc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Factura / RUC"
                            android:textSize="13sp"
                            android:textColor="#333333" />

                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDocumento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:startIconDrawable="@drawable/icono_usuario">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtClienteDocumento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="DNI del Cliente (8 dígitos)"
                            android:inputType="number"
                            android:maxLength="11" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:startIconDrawable="@drawable/icono_texto">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtClienteNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nombre del Cliente / Razón Social"
                            android:inputType="textPersonName" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- FECHA AUTO-LLENADA -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fecha de emisión"
                                android:textSize="12sp"
                                android:textColor="#666666"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtFechaVenta"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:background="@drawable/bg_field"
                                android:text="14/08/2026"
                                android:textSize="13sp"
                                android:textColor="#222222" />

                        </LinearLayout>

                        <!-- METODO DE PAGO -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Método de pago"
                                android:textSize="12sp"
                                android:textColor="#666666"
                                android:layout_marginBottom="4dp" />

                            <Spinner
                                android:id="@+id/spinnerMetodoPago"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_field"
                                android:paddingHorizontal="8dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD BUSQUEDA / ESCANEO DE PRODUCTO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Producto a Vender"
                        android:textColor="@color/orange_stronge"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <!-- FILA ESCANER Y BUSCADOR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <Spinner
                            android:id="@+id/spinnerProductos"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_field"
                            android:paddingHorizontal="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEscanearVenta"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:text="Escanear"
                            app:icon="@drawable/ic_barcode_scan"
                            app:iconGravity="textStart"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/orange_stronge" />

                    </LinearLayout>

                    <!-- FILA CANTIDAD CON STEPPER Y PRECIO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <!-- CANTIDAD -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cantidad"
                                android:textSize="12sp"
                                android:textColor="#666666"
                                android:layout_marginBottom="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_field"
                                android:padding="2dp">

                                <ImageButton
                                    android:id="@+id/btnMenosCantidad"
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:background="@android:color/transparent"
                                    android:src="@android:drawable/ic_input_delete"
                                    app:tint="@color/orange_stronge" />

                                <EditText
                                    android:id="@+id/txtCantidad"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:text="1"
                                    android:gravity="center"
                                    android:inputType="number"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:background="@android:color/transparent" />

                                <ImageButton
                                    android:id="@+id/btnMasCantidad"
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:background="@android:color/transparent"
                                    android:src="@android:drawable/ic_input_add"
                                    app:tint="@color/orange_stronge" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- PRECIO UNITARIO -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="P. Unitario"
                                android:textSize="12sp"
                                android:textColor="#666666"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtPrecioUnitario"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:background="@drawable/bg_field"
                                android:text="S/ 0.00"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/verde_principal" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PARTE INFERIOR EN BLANCO: DETALLE DEL PRODUCTO Y TOTAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProductoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detalle del Producto Seleccionado"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- VISTA PREVIA DEL PRODUCTO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/imgProductoPreview"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:src="@drawable/icono_camara"
                            android:background="@drawable/bg_field"
                            android:padding="4dp"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvNombreProductoSeleccionado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Selecciona o escanea un producto"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A" />

                            <TextView
                                android:id="@+id/tvCategoriaProductoSeleccionado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Categoría: -"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tvStockProductoSeleccionado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stock disponible: -"
                                android:textSize="12sp"
                                android:textColor="@color/orange_stronge"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- SEPARADOR -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginBottom="12dp" />

                    <!-- SUB-TOTAL AUTO-CALCULADO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal (Base Imponible):"
                            android:textSize="13sp"
                            android:textColor="#64748B" />

                        <TextView
                            android:id="@+id/txtSubtotalCalculado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S/ 0.00"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#334155" />

                    </LinearLayout>

                    <!-- IGV (18%) AUTO-CALCULADO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="I.G.V. (18%):"
                            android:textSize="13sp"
                            android:textColor="#64748B" />

                        <TextView
                            android:id="@+id/txtIgvCalculado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S/ 0.00"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#334155" />

                    </LinearLayout>

                    <!-- TOTAL AUTO-CALCULADO (SUBTOTAL + IGV) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOTAL A COBRAR:"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1E293B" />

                        <TextView
                            android:id="@+id/txtTotalCalculado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S/ 0.00"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/verde_principal" />

                    </LinearLayout>

                    <!-- BOTON CONFIRMAR VENTA -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegistrarVenta"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="Confirmar y Registrar Venta"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/orange_stronge" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BOTON HISTORIAL DE VENTAS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistorialVentas"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Ver Historial de Ventas"
                android:textColor="@color/orange_stronge"
                app:strokeColor="@color/orange_stronge"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="24dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>